{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        /*
         * SPA fallback: the app uses client-side routing, so any unknown path
         * must serve index.html rather than 404. Firebase Hosting serves the
         * real file first, then applies this rewrite.
         */
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        /* Hashed build assets are immutable -> cache them hard. */
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        /* index.html must never be cached, or users get stale asset URLs. */
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        /*
         * Dish photos live in public/ under stable filenames, so unlike
         * /assets/** they are not content-hashed. Caching them for an hour
         * means a corrected photo keeps serving the old one, which is exactly
         * how a bad image survived a redeploy here. Force revalidation instead.
         */
        "source": "/dishes/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": {
      "port": 8080,
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json",
      "seed": "emulator-data/firestore-seed.json"
    },
    "storage": {
      "port": 9199,
      "rules": "storage.rules"
    },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
