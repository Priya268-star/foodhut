# Normalise line endings so the repository is identical on every machine.
#
# Without this, a Windows checkout rewrites every LF file to CRLF the next time
# git touches it, and the whole tree shows up as modified on Linux and macOS.
# Text files are checked out with the platform's convention but stored with LF,
# which is what git normally expects.

* text=auto eol=lf

# Windows-only scripts must keep CRLF; cmd.exe will not run an LF batch file.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary - never touched.
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
