# ---------------------------------------------------------------------------
# Foodhut environment
#
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored - never commit real values.
#
# Where to find these:
#   Firebase console > Project settings > General > Your apps > SDK setup
#   (Register a Web app if you have not already; you can register several apps
#    in one project, but they must all share this project id.)
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# Optional. Only change this if you use a non-default Google OAuth client.
# VITE_FIREBASE_GOOGLE_PROVIDER_ID=google.com

# ---------------------------------------------------------------------------
# Local emulator suite
#
# Set to `true` and run `npm run emulators` in a second terminal to work
# entirely offline. Leave `false` for real Firebase projects.
# ---------------------------------------------------------------------------
VITE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199
