{
  "name": "foodhut",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Foodhut - a food delivery marketplace built with React, TypeScript, and Firebase",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "firebase emulators:start",
    "test:rules": "node --experimental-strip-types --disable-warning=ExperimentalWarning tests/firestore.rules.test.ts",
    "test:e2e": "playwright-cli open https://foodhut-zomato-clone.web.app --browser=chrome && playwright-cli run-code --filename=tests/e2e/smoke.js --raw",
    "test:auth": "playwright-cli open https://foodhut-zomato-clone.web.app --browser=chrome && playwright-cli run-code --filename=tests/e2e/auth.js --raw",
    "test:order": "playwright-cli open https://foodhut-zomato-clone.web.app --browser=chrome && playwright-cli run-code --filename=tests/e2e/order.js --raw",
    "test:admin": "playwright-cli open https://foodhut-zomato-clone.web.app --browser=chrome && playwright-cli run-code --filename=tests/e2e/admin.js --raw",
    "sync:firestore": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync-firestore-from-seed.mts",
    "sync:firestore:apply": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync-firestore-from-seed.mts --apply",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "seed:emulator": "node --experimental-strip-types scripts/generate-emulator-seed.ts",
    "indexes": "node --experimental-strip-types scripts/generate-indexes.mts",
    "indexes:apply": "node --experimental-strip-types scripts/apply-indexes.mts",
    "images": "node --experimental-strip-types scripts/fetch-dish-images.mts",
    "images:placeholder": "node --experimental-strip-types scripts/generate-image-placeholders.mts",
    "images:verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-images.mts",
    "images:drop": "powershell -ExecutionPolicy Bypass -File scripts/apply-dropped-photos.ps1",
    "images:credits": "node --experimental-strip-types scripts/build-credits.mts",
    "images:wire": "node --experimental-strip-types scripts/wire-seed-images.mts",
    "probe:queries": "node --experimental-strip-types scripts/probe-queries.mts",
    "deploy": "npm run build && firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
